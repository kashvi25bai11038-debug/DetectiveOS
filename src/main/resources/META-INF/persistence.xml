<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="detectivePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.detectiveos.model.User</class>
        <class>com.detectiveos.model.CaseFile</class>
        <class>com.detectiveos.model.Person</class>
        <class>com.detectiveos.model.Suspect</class>
        <class>com.detectiveos.model.Witness</class>
        <class>com.detectiveos.model.Victim</class>
        <class>com.detectiveos.model.Evidence</class>
        <class>com.detectiveos.model.Statement</class>
        <class>com.detectiveos.model.TimelineEvent</class>
        <class>com.detectiveos.model.Investigation</class>
        <class>com.detectiveos.model.Accusation</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
        </properties>
    </persistence-unit>
</persistence>
